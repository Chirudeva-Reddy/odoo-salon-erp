<odoo>
    <record id="salon_customer_action" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type', '!=', 'private')]</field>
        <field name="context">{'default_type': 'contact'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a salon customer
            </p>
            <p>
                Use customers to keep booking history and loyalty balances together.
            </p>
        </field>
    </record>

    <record id="view_partner_form_salon" model="ir.ui.view">
        <field name="name">res.partner.form.salon</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_salon_bookings" type="object" class="oe_stat_button" icon="fa-calendar" groups="salon_erp.group_salon_user,salon_erp.group_salon_manager">
                    <field name="salon_booking_count" widget="statinfo" string="Bookings"/>
                </button>
                <button name="action_view_salon_loyalty" type="object" class="oe_stat_button" icon="fa-star" groups="salon_erp.group_salon_user,salon_erp.group_salon_manager">
                    <field name="salon_loyalty_balance" widget="statinfo" string="Points"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
