<odoo>
    <record id="salon_booking_reporting_graph" model="ir.ui.view">
        <field name="name">salon.booking.reporting.graph</field>
        <field name="model">salon.booking</field>
        <field name="arch" type="xml">
            <graph string="Bookings Analysis">
                <field name="staff_id"/>
                <field name="amount_total" type="measure"/>
                <field name="loyalty_points_earned" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="salon_booking_reporting_pivot" model="ir.ui.view">
        <field name="name">salon.booking.reporting.pivot</field>
        <field name="model">salon.booking</field>
        <field name="arch" type="xml">
            <pivot string="Bookings Analysis">
                <field name="staff_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="loyalty_points_earned" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="salon_booking_reporting_action" model="ir.actions.act_window">
        <field name="name">Reporting</field>
        <field name="res_model">salon.booking</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="salon_booking_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analyze salon activity
            </p>
            <p>
                Track booking volume, revenue, and loyalty output by staff and state.
            </p>
        </field>
    </record>
</odoo>
