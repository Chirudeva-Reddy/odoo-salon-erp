<odoo>
    <record id="module_category_salon" model="ir.module.category">
        <field name="name">Salon</field>
        <field name="sequence">30</field>
    </record>

    <record id="res_groups_privilege_salon" model="res.groups.privilege">
        <field name="name">Salon</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="salon_erp.module_category_salon"/>
    </record>

    <record id="group_salon_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="salon_erp.res_groups_privilege_salon"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_salon_staff" model="res.groups">
        <field name="name">Staff</field>
        <field name="privilege_id" ref="salon_erp.res_groups_privilege_salon"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_salon_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="salon_erp.res_groups_privilege_salon"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('salon_erp.group_salon_user'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('salon_erp.group_salon_manager'))]"/>
    </record>

    <record id="salon_service_company_rule" model="ir.rule">
        <field name="name">Salon services company access</field>
        <field name="model_id" ref="model_salon_service"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('salon_erp.group_salon_user')), (4, ref('salon_erp.group_salon_staff'))]"/>
    </record>

    <record id="salon_service_category_company_rule" model="ir.rule">
        <field name="name">Salon categories company access</field>
        <field name="model_id" ref="model_salon_service_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('salon_erp.group_salon_user')), (4, ref('salon_erp.group_salon_staff'))]"/>
    </record>

    <record id="salon_staff_company_rule" model="ir.rule">
        <field name="name">Salon staff company access</field>
        <field name="model_id" ref="model_salon_staff"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('salon_erp.group_salon_user')), (4, ref('salon_erp.group_salon_staff'))]"/>
    </record>

    <record id="salon_booking_company_rule" model="ir.rule">
        <field name="name">Salon bookings company access</field>
        <field name="model_id" ref="model_salon_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('salon_erp.group_salon_user'))]"/>
    </record>

    <record id="salon_booking_line_company_rule" model="ir.rule">
        <field name="name">Salon booking lines company access</field>
        <field name="model_id" ref="model_salon_booking_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('salon_erp.group_salon_user'))]"/>
    </record>

    <record id="salon_loyalty_ledger_company_rule" model="ir.rule">
        <field name="name">Salon loyalty company access</field>
        <field name="model_id" ref="model_salon_loyalty_ledger"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('salon_erp.group_salon_user'))]"/>
    </record>

    <record id="salon_booking_staff_own_rule" model="ir.rule">
        <field name="name">Salon staff own bookings only</field>
        <field name="model_id" ref="model_salon_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('staff_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('salon_erp.group_salon_staff'))]"/>
    </record>

    <record id="salon_booking_line_staff_own_rule" model="ir.rule">
        <field name="name">Salon staff own booking lines only</field>
        <field name="model_id" ref="model_salon_booking_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('booking_id.staff_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('salon_erp.group_salon_staff'))]"/>
    </record>
</odoo>
